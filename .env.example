# Garmin Zugangsdaten
GARMIN_EMAIL=deine@email.de
GARMIN_PASSWORD=dein-passwort

# Google Gemini API Key (aus Google AI Studio)
GEMINI_API_KEY=dein-api-key

# Withings Zugangsdaten (siehe withings_auth.py)
WITHINGS_CLIENT_ID=deine-client-id
WITHINGS_CLIENT_SECRET=dein-client-secret
WITHINGS_REDIRECT_URI="https://example.com"

# Stündlicher Withings-Auto-Sync (siehe withings_auto_sync.py) - default an. Läuft withings_tokens/
# credentials.json auf mehreren Instanzen (z.B. Dev-Rechner + Server), MUSS auf allen bis auf eine
# Instanz auf "false" gesetzt werden - Withings rotiert den refresh_token bei jeder Nutzung, sonst
# invalidieren sich die Instanzen gegenseitig.
# WITHINGS_AUTO_SYNC_ENABLED=true
